# Copy to .env and adjust. Used by docker-compose.
# NOTE: no inline comments after values — in .env everything after "=" is the value.

# --- App: три среды (prod/preprod/test) — отдельные инстансы со своими БД ---
APP_PORT=8080
APP_PORT_PREPROD=8081
APP_PORT_TEST=8082
DB_PORT_PREPROD=5433
DB_PORT_TEST=5434
# docker = bundled DB + schema; prod = external corporate DB
SPRING_PROFILES_ACTIVE=docker

# --- First super-admin (created on first startup) ---
# Супер-админы: несколько адресов через запятую (нужен второй, чтобы было кому
# закрыть учётку уходящему — свою супер-админ отключить не может).
ADMIN_EMAIL=admin@banki.ru
ADMIN_PASSWORD=change-me-please

# --- Выкатки (раздел «Выкатки» в настройках) ---
# Общий секрет, которым контуры спрашивают друг у друга версию сборки. Пусто = соседей
# не опрашиваем, раздел покажет только свою версию.
DEPLOY_PEER_TOKEN=
# Ветка и каталог на сервере — подставляются в текст команды выката.
DEPLOY_BRANCH=admin-panel
DEPLOY_DIR=~/crm.banki.ru
# Домен корпоративной почты для заведения пользователей. Пусто = banki.ru
# (проверка обязательна: адреса других доменов завести нельзя).
APP_EMAIL_DOMAIN=

# --- Постоянная авторизация ---
# Секрет для подписи remember-me токена (задай свой в проде, стабильный между рестартами)
REMEMBER_ME_KEY=crm-admin-remember-me-key-change-me
# Срок жизни remember-me куки (дней) и таймаут неактивной сессии
REMEMBER_ME_DAYS=30
SESSION_TIMEOUT=7d

# --- Bundled dev DB (profile=docker) ---
DB_NAME=crm
DB_USER=crm
DB_PASSWORD=crm
DB_PORT=5432
DB_URL=jdbc:postgresql://db:5432/crm

# --- Внешняя прод-БД (схемы notice/callcenter, таблицы 1:1) ---
# Синк шаблонов мастера: очередь app.prod_sync доставляет операции сюда.
# Пусто = синк выключен (очередь копится в PENDING, доставится после настройки).
# Прод-контур: PROD_DB_URL; препрод/тест — свои переменные (можно направить на тестовую копию прода).
# PROD_DB_URL=jdbc:postgresql://prod-host:5432/notice
# PROD_DB_URL_PREPROD=
# PROD_DB_URL_TEST=
# PROD_DB_USER=
# PROD_DB_PASSWORD=

# --- Сервер (docker-compose.server.yml): домен обслуживает nginx -> только прод ---
# Приложения и БД наружу не торчат; preprod/test — только с сервера / по SSH-туннелю.
# На локальной машине НЕ задавай (по умолчанию 0.0.0.0 для приложений).
# APP_BIND=127.0.0.1
# DB_BIND=127.0.0.1

# --- Production DB (profile=prod): point to the real corporate PostgreSQL ---
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:postgresql://prod-host:5432/proddb
# DB_USER=...
# DB_PASSWORD=...

# --- Сверка событий с crmdb ---
# Частый опрос хвоста (что новее нашего последнего id) плюс полная сверка вечером.
# Выключено по умолчанию: включать там, где crmdb действительно своя, а не боевая.
EVENT_IMPORT_ENABLED=false
EVENT_IMPORT_INTERVAL_MS=300000
EVENT_IMPORT_FULL_CRON=0 30 22 * * *
