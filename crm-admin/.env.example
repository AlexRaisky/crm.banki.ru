# Copy to .env and adjust. Used by docker-compose.
# NOTE: no inline comments after values — in .env everything after "=" is the value.

# --- App: три среды (prod/preprod/test) — отдельные инстансы со своими БД ---
APP_PORT=8080
APP_PORT_PREPROD=8081
APP_PORT_TEST=8082
DB_PORT_PREPROD=5433
DB_PORT_TEST=5434
# docker = bundled DB + schema; prod = external corporate DB
SPRING_PROFILES_ACTIVE=docker

# --- First super-admin (created on first startup) ---
ADMIN_EMAIL=admin@banki.ru
ADMIN_PASSWORD=change-me-please
# Restrict logins to a domain (e.g. banki.ru). Leave empty for any.
APP_EMAIL_DOMAIN=

# --- Постоянная авторизация ---
# Секрет для подписи remember-me токена (задай свой в проде, стабильный между рестартами)
REMEMBER_ME_KEY=crm-admin-remember-me-key-change-me
# Срок жизни remember-me куки (дней) и таймаут неактивной сессии
REMEMBER_ME_DAYS=30
SESSION_TIMEOUT=7d

# --- Bundled dev DB (profile=docker) ---
DB_NAME=crm
DB_USER=crm
DB_PASSWORD=crm
DB_PORT=5432
DB_URL=jdbc:postgresql://db:5432/crm

# --- Сервер (docker-compose.server.yml): домен обслуживает nginx -> только прод ---
# Приложения и БД наружу не торчат; preprod/test — только с сервера / по SSH-туннелю.
# На локальной машине НЕ задавай (по умолчанию 0.0.0.0 для приложений).
# APP_BIND=127.0.0.1
# DB_BIND=127.0.0.1

# --- Production DB (profile=prod): point to the real corporate PostgreSQL ---
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:postgresql://prod-host:5432/proddb
# DB_USER=...
# DB_PASSWORD=...
